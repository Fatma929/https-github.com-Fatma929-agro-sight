# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase Multi-Tenant Cloud Database Credentials (optional - local persistence is active by default)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=MY_SUPABASE_SERVICE_ROLE_KEY

# AgroSight Sentinel-2 Raster Backend Environment Configuration
# Supported values for AGROSIGHT_BACKEND_ENV: LOCAL_EMULATOR | PHYSICAL_DEVICE | STAGING | PRODUCTION
# Note: STAGING and PRODUCTION strictly enforce HTTPS base URLs.
AGROSIGHT_BACKEND_ENV=LOCAL_EMULATOR
AGROSIGHT_BACKEND_BASE_URL=http://10.0.2.2:8090/

# GOOGLE_MAPS_API_KEY: Required for Google Maps SDK for Android native map tiles.
GOOGLE_MAPS_API_KEY=MY_GOOGLE_MAPS_API_KEY

# MAPBOX_ACCESS_TOKEN: Optional Mapbox access token for Mapbox satellite imagery styles.
MAPBOX_ACCESS_TOKEN=MY_MAPBOX_ACCESS_TOKEN


