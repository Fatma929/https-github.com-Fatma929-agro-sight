<?xml version="1.0" encoding="utf-8"?>
<!--
   Privacy-hardened Auto Backup configuration (API <= 30).
   Excludes local SharedPreferences and Room SQLite databases that store farmer PII
   (14-digit Egyptian National ID, phone numbers, email addresses, and field telemetry).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="agrosight_multi_tenant_db.xml" />
    <exclude domain="database" path="agrosight_sql_audit.db" />
    <exclude domain="database" path="agrosight_sql_audit.db-shm" />
    <exclude domain="database" path="agrosight_sql_audit.db-wal" />
</full-backup-content>
