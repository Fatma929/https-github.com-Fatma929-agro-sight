<?xml version="1.0" encoding="utf-8"?>
<!--
   Privacy-hardened Data Extraction rules (API 31+).
   Excludes sensitive farmer PII (Egyptian National IDs, WhatsApp numbers, emails, and SQL audits)
   from cloud backups and unencrypted device-to-device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="agrosight_multi_tenant_db.xml" />
        <exclude domain="database" path="agrosight_sql_audit.db" />
        <exclude domain="database" path="agrosight_sql_audit.db-shm" />
        <exclude domain="database" path="agrosight_sql_audit.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="agrosight_multi_tenant_db.xml" />
        <exclude domain="database" path="agrosight_sql_audit.db" />
        <exclude domain="database" path="agrosight_sql_audit.db-shm" />
        <exclude domain="database" path="agrosight_sql_audit.db-wal" />
    </device-transfer>
</data-extraction-rules>
